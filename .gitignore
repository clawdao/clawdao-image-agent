# ─────────────────────────────────────────────────────────────
# ClawDao 图像工厂 — .gitignore
# 包管理器约定：根目录 = Bun（bun.lock），web/ 子项目 = npm（package-lock.json）
# ─────────────────────────────────────────────────────────────

# ── 密钥 / 凭据（绝不入库）────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json
credentials.json
.clawdao/auth.json

# ── 运行产物 / 导出文件（生成物，可随时重建）─────────────────
outputs/
.clawdao-uploads/

# ── 本地数据库（SQLite 及 WAL/SHM 副本）──────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── 依赖目录 ─────────────────────────────────────────────────
node_modules/

# ── 历史遗留的 Yarn PnP 产物 ──────────────────────────────────
# 主线包管理器是 Bun（见 package.json engines），以下为早期 yarn 安装残留。
# 保留 bun.lock；根目录不要再引入 yarn.lock，避免双锁文件歧义。
.yarn/
.pnp.cjs
.pnp.loader.mjs
yarn.lock

# ── 历史归档（egg.js / server-egg-legacy，不参与构建）────────
.archive/

# ── 构建产物 / 缓存 ──────────────────────────────────────────
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# ── 日志 ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 系统 / 编辑器 ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
